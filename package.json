{
  "name": "russmarket-shifts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "lucide-react": "^0.468.0",
    "postgres": "^3.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
